# Environment configuration for TruthTrace (Safe Template)
# Copy this file to .env and adjust variables as needed.

APP_NAME=TruthTrace
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# Secret key used for session security and cryptographic derivation
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars

# Optional pre-generated Fernet key (if blank, derived from SECRET_KEY automatically)
FERNET_KEY=

# Allowed CORS origins (comma-separated, e.g. http://localhost:5500,https://sham-b.github.io)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Hosting and Resource Modes (0 = disabled / full local, 1 = enabled / lean hosting)
DEMO_MODE=0
LOW_MEMORY=0
DISABLE_OCR=0

# LLM Provider: template (default offline), ollama, gemini, or none
LLM_PROVIDER=template
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_URL=http://localhost:11434
GEMINI_API_KEY=

# Database configuration
DATABASE_URL=sqlite:///./data/truthtrace.db
